<?xml version="1.0"?>
<!-- Autonomous Lamp (Autonomous OS, LeLamp-derived 5x STS3215 desk lamp). -->
<!-- Generated by scripts/lamp_build_urdf.py from the vendor CAD (lamp.glb); see urdf/README.md. -->
<!-- Joint values are the vendor's own (hal ServoMoveRequest / recordings CSV), degrees -> radians, no sign or offset. -->
<robot name="autonomous_lamp">
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/base.stl" scale="1 1 1"/></geometry>
      <material name="base_mat"><color rgba="0.93 0.90 0.84 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/base.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="9e-05" ixy="0" ixz="0" iyy="9e-05" iyz="0" izz="9e-05"/>
    </inertial>
  </link>

  <joint name="base_yaw" type="revolute">
    <origin xyz="0 0 0.0495" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="swivel"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.570796" upper="1.570796" effort="3.0" velocity="4.36"/>
  </joint>

  <link name="swivel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/swivel.stl" scale="1 1 1"/></geometry>
      <material name="swivel_mat"><color rgba="0.93 0.90 0.84 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/swivel.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="1.2e-05" ixy="0" ixz="0" iyy="1.2e-05" iyz="0" izz="1.2e-05"/>
    </inertial>
  </link>

  <joint name="base_pitch" type="revolute">
    <origin xyz="0 0 0.0471" rpy="0 -0.520108 0"/>
    <parent link="swivel"/>
    <child link="lower_arm"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="3.0" velocity="4.36"/>
  </joint>

  <link name="lower_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/lower_arm.stl" scale="1 1 1"/></geometry>
      <material name="lower_arm_mat"><color rgba="0.93 0.90 0.84 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/lower_arm.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/>
    </inertial>
  </link>

  <joint name="elbow_pitch" type="revolute">
    <origin xyz="-0.0948 0 0.0986" rpy="0 0.472984 0"/>
    <parent link="lower_arm"/>
    <child link="upper_arm"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="3.0" velocity="4.36"/>
  </joint>

  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/upper_arm.stl" scale="1 1 1"/></geometry>
      <material name="upper_arm_mat"><color rgba="0.93 0.90 0.84 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/upper_arm.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.14"/>
      <inertia ixx="1.4e-05" ixy="0" ixz="0" iyy="1.4e-05" iyz="0" izz="1.4e-05"/>
    </inertial>
  </link>

  <joint name="wrist_pitch" type="revolute">
    <origin xyz="0.0706 0 0.0684" rpy="0 0.459022 0"/>
    <parent link="upper_arm"/>
    <child link="neck"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="3.0" velocity="4.36"/>
  </joint>

  <link name="neck">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/neck.stl" scale="1 1 1"/></geometry>
      <material name="neck_mat"><color rgba="0.35 0.35 0.35 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/neck.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="5e-06" ixy="0" ixz="0" iyy="5e-06" iyz="0" izz="5e-06"/>
    </inertial>
  </link>

  <joint name="wrist_roll" type="revolute">
    <origin xyz="0.0377 0 0.0415" rpy="0.0960535 -0.00508842 0.10577"/>
    <parent link="neck"/>
    <child link="head"/>
    <axis xyz="-0.672406 0 -0.740182"/>
    <limit lower="-1.570796" upper="1.570796" effort="3.0" velocity="4.36"/>
  </joint>

  <link name="head">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/head.stl" scale="1 1 1"/></geometry>
      <material name="head_mat"><color rgba="0.93 0.90 0.84 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/head.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="1.8e-05" ixy="0" ixz="0" iyy="1.8e-05" iyz="0" izz="1.8e-05"/>
    </inertial>
  </link>

</robot>

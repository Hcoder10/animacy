  "order": "retrieve (cosine + continuity + speaking + arousal bonus + proto_weight * proto[intent]) or decode+smooth -> amplitude tier by intent -> energy floor (one scalar for the whole utterance, 1.0..2.0) -> pitch floor -> settle (after speech ends) -> clamp to channel bounds",
  "amplitude_tiers": {
   "excitement": 1.45,
   "greeting": 1.25,
   "agreement": 1.15,
   "doubt": 1.15,
   "thinking": 0.9,
   "neutral": 1.0

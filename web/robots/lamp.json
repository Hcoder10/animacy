      "elbow_pitch": {
        "terms": [
          {
            "from": "head_z",
            "gain": 0.35
          },
          {
            "from": "torso_lean_fwd",
            "gain": 0.4
          },
          {
            "from": "mouth_open",
            "gain": 6.0
          }
        ],
        "offset": 0.0,
        "min": -5.0,
        "max": 62.0,
        "deadband": 0.0,
        "smooth_hz": 4.0
      }

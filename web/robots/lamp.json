        "offset": -25.0,
        "min": -10.0,
        "max": 65.0,
        "deadband": 0.0,
        "smooth_hz": 6.0
      },
      "wrist_roll": {
        "terms": [
          {
            "from": "wrist_roll",
            "gain": -1.0
          }
        ],
        "offset": 0.0,
        "min": -70.0,
        "max": 85.0,
        "deadband": 0.0,
        "smooth_hz": 8.0
      },
      "wrist_pitch": {
        "terms": [
          {
            "from": "wrist_pitch",
            "gain": -1.0
          }
        ],
        "offset": 0.0,
        "min": -90.0,
        "max": 30.0,
        "deadband": 0.0,
        "smooth_hz": 8.0
      }
    }
